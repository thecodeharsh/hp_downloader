# HP Downloader Environment Configuration
# Created by Harsh Kumar <kum.harshofficial@gmail.com>

# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# Security & CORS
# Production frontend origin(s), comma-separated. Local development defaults
# to localhost when this variable is unset.
CORS_ORIGIN=https://hp-downloader.vercel.app

# Python & Executables
PYTHON_PATH=python

# Storage & Temp Directories
# On Linux/Docker: /tmp/hp-downloader-temp
# On Windows: will default to os.tmpdir()
TEMP_DIR=

# Limits & Timeouts
MAX_FILE_SIZE_MB=250
MAX_CONCURRENT_DOWNLOADS=2
ANALYZE_TIMEOUT_MS=35000
DOWNLOAD_TIMEOUT_MS=180000
JOB_TTL_MINUTES=15
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Creator & Support
SUPPORT_EMAIL=kum.harshofficial@gmail.com
APP_NAME=HP Downloader
CREATOR_NAME=Harsh Kumar
